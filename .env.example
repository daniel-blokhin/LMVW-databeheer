# Never commit a populated .env file. This example is documentation only.
# API keys are read from the environment at runtime (no dotenv autoload).
DSO_API_KEY_PRODUCTION=
DSO_API_KEY_PRE=
# Prefer *_FILE for a mounted secret with user-only permissions (chmod 600).
# DSO_API_KEY_PRODUCTION_FILE=
# DSO_API_KEY_PRE_FILE=
