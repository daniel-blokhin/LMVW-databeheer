# Documentation only. This file is NOT automatically loaded.
# Inject only the credential needed for the selected environment at runtime.
# Never place real values in this example or pass a key as a CLI argument.
DSO_API_KEY_PRODUCTION=
DSO_API_KEY_PRE=
RUIMTELIJKE_PLANNEN_API_KEY=

# Alternative: set ONE corresponding _FILE variable to a private mounted file.
# Do not set the direct value and _FILE for the same credential simultaneously.
# On POSIX use mode 600; on Windows restrict the file's ACL to the runtime identity.
# DSO_API_KEY_PRODUCTION_FILE=
# DSO_API_KEY_PRE_FILE=
# RUIMTELIJKE_PLANNEN_API_KEY_FILE=
